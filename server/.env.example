# Substack RSS (Writing section). Host only, no https://
SUBSTACK_PUBLICATION=sloiterstein.substack.com
# The contact form logs messages in local development when mail credentials are missing.

# Server
PORT=4000
NODE_ENV=development
# Comma separated list of allowed origins for CORS in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CLIENT_URL=http://127.0.0.1:5173

# Preferred: Resend API (best deliverability on Vercel).
# Verify sam-loiterstein.com in Resend, then use a sender on that domain.
RESEND_API_KEY=re_your_api_key
CONTACT_TO=samloiterstein@gmail.com
CONTACT_FROM="Sam Loiterstein Website <noreply@sam-loiterstein.com>"

# Optional fallback: SMTP (Resend SMTP, Postmark, SendGrid, Mailgun, etc.).
# Do not leave SMTP_HOST as smtp.example.com in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Supabase (Genre Intelligence — events + genres tables)
SUPABASE_URL=https://glpiolbrafqikqhnseto.supabase.co
# Preferred: new secret API key (sb_secret_…)
SUPABASE_SECRET_KEY=
# Legacy service_role JWT (optional fallback)
SUPABASE_SERVICE_ROLE_KEY=
# Alternative: single-line key file (gitignored)
# SUPABASE_SECRET_KEY_PATH=./secrets/supabase-secret.key

# Spotify OAuth (Genre Intelligence taste import)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify redirect URI — must use loopback IP, NOT "localhost" (Spotify security policy)
# Local dev: http://127.0.0.1:5173/api/music/spotify/callback
# Production: https://sam-loiterstein.com/api/music/spotify/callback
SPOTIFY_REDIRECT_URI=

# Apple MusicKit (Genre Intelligence taste import)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
